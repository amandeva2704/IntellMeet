PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/intellmeet?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173
USE_LOCAL_MONGO=false

# OpenAI API Key for Whisper speech-to-text and AI summaries
OPENAI_API_KEY=your_openai_api_key_here

# (Optional Free Alternative) Groq API Key for free Whisper speech-to-text (console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
